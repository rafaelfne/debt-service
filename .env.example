APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# Provider URLs (consumed by config/business.php → providers.{a,b}.url)
#--------------------------------------------------------------------------
PROVIDER_A_URL=http://localhost:8000/mock/provider-a
PROVIDER_B_URL=http://localhost:8000/mock/provider-b

#--------------------------------------------------------------------------
# Runtime business knobs (defaults match the canon enunciado — uncomment
# only to override). Edit + restart → output reflects the new value.
#--------------------------------------------------------------------------

# Interest policies
# IPVA_DAILY_RATE=0.0033      # taxa diária do IPVA (default 0.33%)
# IPVA_CAP_RATE=0.20          # teto do juro do IPVA (default 20% do valor)
# MULTA_DAILY_RATE=0.01       # taxa diária de multa (default 1%/dia, sem teto)

# Payment simulators
# PIX_DISCOUNT_FACTOR=0.95    # fator do desconto Pix (default 5% off)
# CC_MONTHLY_RATE=0.025       # taxa mensal do cartão (default 2,5% a.m.)

# Provider A network knobs
# PROVIDER_A_TIMEOUT=2        # segundos
# PROVIDER_A_RETRIES=3
# PROVIDER_A_BACKOFF_MS=100

# Provider B network knobs (idem)
# PROVIDER_B_TIMEOUT=2
# PROVIDER_B_RETRIES=3
# PROVIDER_B_BACKOFF_MS=100

# Resilience
# CHAIN_BUDGET_SECONDS=5.0    # budget global de wall-clock do ProviderChain
# CB_FAILURE_THRESHOLD=5      # falhas consecutivas para abrir o breaker
# CB_COOLDOWN_SECONDS=30.0    # janela de open antes de tentar de novo

# HTTP
# HTTP_MAX_BODY_BYTES=1048576 # 1 MiB por default
